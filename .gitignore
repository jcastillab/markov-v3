# Entorno virtual
.venv/
venv/

# Outputs del pipeline (se regeneran)
outputs/
!outputs/.gitkeep

# Datos de entrada: los xlsx son inmutables y versionados;
# se ignoran copias temporales de trabajo y lockfiles de Excel.
data/**/~$*.xlsx
**/~$*.xlsx
*.lock

# Proyectos externos de solo lectura
/Vision-artificial/
/entrega_almer_*/
/integracion_externa/Vision-artificial/
/integracion_externa/entrega_almer_*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Excel de salida generados
*.tmp
~$*.xlsx

# OS
Thumbs.db
.DS_Store
